node_modules/
.DS_Store
*.log
.vercel
.env
*.env

# Alumni data exports — never commit personal data
*.csv
!sample_alumni_import_template.csv
_tmp_*

# Generated administrator passwords written by rotate_credentials.js.
# Store them in a password manager and delete the file — never commit it.
admin-credentials.local.txt
*credentials*.local.txt

# Password reset links issued by reset_link.js. Single-use and short-lived,
# but still a credential while they are valid.
reset-link.local.txt
*reset-link*.local.txt

# Database backups. Never committed, never served: backup.js writes here and
# the web root allow-list in server.js does not include this directory.
backups/
*.sql.gz

uploads/

# Build-time geometry downloads (geoBoundaries). Fetched by tools/build_geo.js
# from a pinned upstream commit; only the simplified assets/geo/boundaries.json
# is committed.
tools/.geocache/
