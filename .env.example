# Neon / Cloud PostgreSQL Connection String Example
DATABASE_URL="postgresql://user:password@your-cloud-host.neon.tech/neondb?sslmode=require"
PORT=8000

# Secret used to sign session tokens (HMAC-SHA256).
# REQUIRED in production. If unset the server generates an ephemeral secret at
# boot, which means every restart invalidates all active sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-32-byte-random-hex-string"

# AES-256-GCM key for encrypting NID/BRC identity fields (REQ-14, PDPA 2026).
# REQUIRED for the identity vault. Without it the vault endpoints refuse to
# store data rather than silently saving plaintext.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="replace-with-64-hex-chars"

# ─── ADMINISTRATOR PASSWORDS (optional) ───
# Used only by rotate_credentials.js. If a variable is set, that password is
# applied to the matching role; otherwise a 24-character password is generated
# and written to admin-credentials.local.txt (gitignored).
# Minimum 12 characters. Never commit real values.
# ADMIN_PW_SUPER_ADMIN="..."
# ADMIN_PW_UNIV_ADMIN="..."
# ADMIN_PW_DEPT_ADMIN="..."
# ADMIN_PW_MODERATOR="..."

# ─── PORTAL ORIGINS ─────────────────────────────────────────
# The alumni site and the staff portal. Leave both unset while the staff portal
# is served from the same origin at /admin — CORS then keeps its permissive
# development default and nothing cross-origin happens anyway.
#
# Set them when admin.<domain> is pointed at this deployment: only these two
# origins are then allowed, and ADMIN_ORIGIN also tells the server to serve
# admin.html for that host. Credentials stay off: the session is a bearer token
# in a header, never a cookie.
# PUBLIC_ORIGIN="https://alumni.dic.edu.bd"
# ADMIN_ORIGIN="https://admin.dic.edu.bd"

# ─── DESTRUCTIVE OPERATIONS ─────────────────────────────────
# POST /api/seed-db drops and re-seeds. It is refused when NODE_ENV=production
# or VERCEL=1. Set this only on a staging box you are willing to lose.
# ALLOW_DB_RESEED=false

# ─── SCHEDULER (Phase 4) ────────────────────────────────────
# Credential the scheduler presents to /api/internal/jobs/run, as either
# Authorization: Bearer <value> (what Vercel Cron sends) or X-Cron-Key.
# REQUIRED in production: without it nothing can trigger the nightly jobs, and
# the 30-day deletion purge — a promise made to every user who asks to be
# erased — would never run. 32 characters minimum.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="replace-with-a-32-byte-random-hex-string"

# ─── EMAIL (Phase 4) ────────────────────────────────────────
# Password-reset links are delivered by email. Without this an operator has to
# mint every link by hand with reset_link.js, which does not scale past the
# super admin.
#
# MAIL_TRANSPORT decides what happens to a message:
#   smtp     send it (the production setting; SMTP_HOST and SMTP_FROM required)
#   console  print it to the log instead — DEVELOPMENT ONLY, and it says so on
#            every send
#   none     accept and drop, for a deployment that has consciously decided to
#            keep reset_link.js as the only recovery path
# Production refuses to start on 'smtp' without SMTP_HOST and SMTP_FROM.
MAIL_TRANSPORT="smtp"
SMTP_HOST="smtp.your-provider.example"
SMTP_PORT=587
SMTP_USER="apikey-or-username"
SMTP_PASSWORD="never-commit-a-real-value"
SMTP_FROM="DIC Alumni Network <no-reply@your-domain>"

# ─── BACKUPS (Phase 4) ──────────────────────────────────────
# Where backup.js writes. Keep it OUTSIDE the repository on a real deployment:
# the default sits next to the code, which is convenient in development and
# wrong in production. It must not be a directory any web server serves.
BACKUP_DIR="/var/backups/dic-alumni"
BACKUP_RETENTION_DAYS=14
# Development only: run pg_dump inside a container when the client tools are
# not installed on the host. Leave unset in production.
# DOCKER_PG_CONTAINER="dic-alumni-pg"
# Explicit path to pg_dump, if it is not on PATH.
# PG_DUMP="/usr/lib/postgresql/16/bin/pg_dump"

# ─── LOGGING ────────────────────────────────────────────────
# Errors and warnings are always logged. Set to "all" to log every API request
# — useful while diagnosing, noisy as a steady state.
# LOG_REQUESTS="all"
