# Neon / Cloud PostgreSQL Connection String Example
DATABASE_URL="postgresql://user:password@your-cloud-host.neon.tech/neondb?sslmode=require"
PORT=8000

# Secret used to sign session tokens (HMAC-SHA256).
# REQUIRED in production. If unset the server generates an ephemeral secret at
# boot, which means every restart invalidates all active sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-32-byte-random-hex-string"

# AES-256-GCM key for encrypting NID/BRC identity fields (REQ-14, PDPA 2026).
# REQUIRED for the identity vault. Without it the vault endpoints refuse to
# store data rather than silently saving plaintext.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="replace-with-64-hex-chars"

# ─── ADMINISTRATOR PASSWORDS (optional) ───
# Used only by rotate_credentials.js. If a variable is set, that password is
# applied to the matching role; otherwise a 24-character password is generated
# and written to admin-credentials.local.txt (gitignored).
# Minimum 12 characters. Never commit real values.
# ADMIN_PW_SUPER_ADMIN="..."
# ADMIN_PW_UNIV_ADMIN="..."
# ADMIN_PW_DEPT_ADMIN="..."
# ADMIN_PW_MODERATOR="..."

# ─── PORTAL ORIGINS ─────────────────────────────
# The alumni site and the staff portal.
#
# REQUIRED in production, both of them. Until Phase 5E they were optional, and
# leaving them unset handed the CORS middleware `undefined` — which is the
# permissive wildcard, so a production deployment answered every origin with
# Access-Control-Allow-Origin: *. Production now refuses to start without them.
#
# Only these two origins are allowed. ADMIN_ORIGIN also tells the server to
# serve admin.html for that hostname. Credentials stay off: the session is a
# bearer token in a header, never a cookie.
#
# Set them to the SAME value for a single-host deployment where the staff
# portal is reached at /admin — the server detects the shared origin and keeps
# routing by path. Leave the scheme on; the hostname is compared, not the
# string, so admin.alumni.<domain> and alumni.<domain> stay distinct.
PUBLIC_ORIGIN="https://alumni.your-domain"
ADMIN_ORIGIN="https://admin.alumni.your-domain"

# ─── DESTRUCTIVE OPERATIONS ─────────────────────────────────
# POST /api/seed-db drops and re-seeds. It is refused when NODE_ENV=production
# or VERCEL=1. Set this only on a staging box you are willing to lose.
# ALLOW_DB_RESEED=false
#
# migrate_v2.js can seed demonstration content — a poll, event vendors, a
# planning timeline — so a demo environment does not open on empty screens.
# It is OFF unless this is set. It ran unconditionally until Phase 6, so fresh
# PRODUCTION databases were getting invented vendors with made-up phone numbers
# and a live poll on the public news feed, despite the deployment runbook
# telling the operator not to seed. Never set this in production.
# DIC_SEED_DEMO=1

# ─── SCHEDULER (Phase 4) ────────────────────────────────────
# Credential the scheduler presents to /api/internal/jobs/run, as either
# Authorization: Bearer <value> (what Vercel Cron sends) or X-Cron-Key.
# REQUIRED in production: without it nothing can trigger the nightly jobs, and
# the 30-day deletion purge — a promise made to every user who asks to be
# erased — would never run. 32 characters minimum.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="replace-with-a-32-byte-random-hex-string"

# ─── EMAIL (Phase 4) ────────────────────────────────────────
# Password-reset links are delivered by email. Without this an operator has to
# mint every link by hand with reset_link.js, which does not scale past the
# super admin.
#
# MAIL_TRANSPORT decides what happens to a message:
#   smtp     send it (the production setting; SMTP_HOST and SMTP_FROM required)
#   console  print it to the log instead — DEVELOPMENT ONLY, and it says so on
#            every send
#   none     accept and drop, for a deployment that has consciously decided to
#            keep reset_link.js as the only recovery path
# REQUIRED in production, explicitly. An unset MAIL_TRANSPORT used to fall
# through to 'console', so a production deployment that simply forgot the
# variable printed every password-reset link into its log file and believed
# mail was configured. There is no default any more: choose one of the three.
# Production also refuses to start on 'smtp' without SMTP_HOST and SMTP_FROM.
MAIL_TRANSPORT="smtp"
SMTP_HOST="smtp.your-provider.example"
SMTP_PORT=587
SMTP_USER="apikey-or-username"
SMTP_PASSWORD="never-commit-a-real-value"
SMTP_FROM="DIC Alumni Network <no-reply@your-domain>"

# ─── BACKUPS ────────────────────────────────────────────────
# Where backup.js writes.
#
# REQUIRED in production, and production refuses a path that points inside the
# application directory. The old default put a full pg_dump of every alumnus's
# personal data next to the code, which is also the web root — the static
# allow-list refuses to serve it, but a dump belongs somewhere a redeploy, a
# git clean or a future change to that allow-list cannot reach.
#
# Until Phase 6 this variable was read BEFORE .env was loaded, so setting it
# here had no effect at all and dumps landed beside the code regardless.
BACKUP_DIR="/var/backups/dic-alumni"
BACKUP_RETENTION_DAYS=14

# ─── OFF-SITE BACKUP COPY ───────────────────────────────────
# A backup that lives only on the machine it was taken from does not survive
# the failure it exists for. offsite.js runs this command once per dump, with
# {file} replaced by the dump's path and {name} by its basename. No vendor SDK
# and no credential lives in the repository; whatever the command needs in
# order to authenticate is configured in the environment it runs in.
#
#   S3-compatible (AWS, Backblaze B2, Wasabi, MinIO):
# OFFSITE_CMD='aws s3 cp {file} s3://dic-alumni-backups/{name} --sse AES256'
#   Any host reachable over ssh:
# OFFSITE_CMD='scp -q {file} backups@offsite.example:/srv/dic/{name}'
#   rclone, which speaks most institutional cloud storage:
# OFFSITE_CMD='rclone copyto {file} dic-remote:alumni-backups/{name}'
#
# A dump holds every alumnus's personal data in plaintext. Prefer encryption at
# the destination (S3 SSE above, or an encrypted volume). Where the destination
# cannot provide it, encrypt before sending — {out} is the file to write:
# OFFSITE_ENCRYPT_CMD='gpg --batch --yes --encrypt --recipient backups@dic --output {out} {file}'
#
# Whoever holds the decryption key must not be the same person who holds only
# the backups, or the pair is useless. See KEY_MANAGEMENT.md.

# ─── SCHEDULER AND MONITORING ───────────────────────────────
# How long a job may stay marked 'running' before the next run of the same job
# presumes it was killed mid-flight and marks it failed. Without this a job
# that died stayed 'running' for ever, and a monitor could not tell it from one
# that was working.
# JOB_STALE_MINUTES=30
#
# How old the last successful run of a job, or the last backup, may be before
# GET /api/internal/monitor returns 503. The jobs run nightly, so the default
# leaves room for one missed night before anybody is woken at 3am.
# MONITOR_JOB_MAX_HOURS=36
# MONITOR_BACKUP_MAX_HOURS=36

# ─── TIMEZONE ───────────────────────────────────────────────
# The institution's timezone, applied to every database connection so business
# dates are local dates. An event "today", a task due "today" and a grace
# period expiring "today" all mean today in Dhaka.
#
# Leave it alone unless the institution moves. Before Phase 6 nothing pinned
# it, so CURRENT_DATE was the database host's date — usually UTC, six hours
# behind, which put the nightly 02:10 Dhaka run on the previous calendar day
# and rolled event statuses forward a full day late, every time.
# DB_TIMEZONE=Asia/Dhaka
# Development only: run pg_dump inside a container when the client tools are
# not installed on the host. Leave unset in production.
# DOCKER_PG_CONTAINER="dic-alumni-pg"
# Explicit path to pg_dump, if it is not on PATH.
# PG_DUMP="/usr/lib/postgresql/16/bin/pg_dump"

# ─── REVERSE PROXY ─────────────────────────────
# How many reverse proxies sit in front of this process. LEAVE IT UNSET if the
# application is reached directly — that is the safe default.
#
# It matters in both directions, so set it deliberately:
#
#   Set when there is no proxy   — a numeric trust-proxy value is a hop COUNT,
#     not an address allow-list, so the peer is trusted unconditionally and
#     X-Forwarded-For becomes the caller's to choose. Measured in Phase 5F: 32
#     wrong passwords against one account with a rotating forged header produced
#     zero 429 responses, and the forged address is what the audit trail
#     recorded.
#
#   Unset when there IS a proxy  — every request then appears to come from the
#     proxy's address, so the per-IP login throttle counts the whole internet as
#     one client. A handful of failed sign-ins would lock out everybody.
#
# Set it to the number of hops you actually have (usually 1), or to an address
# or CIDR list, which Express also accepts.
# TRUST_PROXY=1

# ─── LOGGING ────────────────────────────────────────────────
# Errors and warnings are always logged. Set to "all" to log every API request
# — useful while diagnosing, noisy as a steady state.
# LOG_REQUESTS="all"

# ─── TESTING ESCAPE HATCH ──────────────────────────
# DIC_SKIP_DOTENV=1 makes the app ignore this file completely. It exists so the
# production fail-closed behaviour can be tested on a machine that has a .env:
# without it, a developer's file supplies the very variable the test is trying
# to remove. It can only make the configuration smaller, never
# weaker-but-running. Never set it on a real deployment.
